# ===== Server Config =====
PORT=4000
NODE_ENV=development

# ===== CORS & API =====
CORS_ORIGIN=http://localhost:2000,http://localhost:5173,http://localhost:3000
VITE_API_BASE_URL=http://localhost:2500/api

# ===== Database (Future Use) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=network_portal
DB_USER=postgres
DB_PASSWORD=changeme

# ===== Auth & Passwords (สำหรับทีม NDS, CDS และ Admin) =====
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# ทีม NDS (เข้าถึงเฉพาะส่วน NDS)
AUTH_NDS_USERNAME=nds
AUTH_NDS_PASSWORD=nds_password

# ทีม CDS (เข้าถึงเฉพาะส่วน CDS)
AUTH_CDS_USERNAME=cds
AUTH_CDS_PASSWORD=cds_password

# Admin / ผู้ใช้ที่เข้าถึงได้ทั้ง 2 ทีม (NDS & CDS)
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=admin_password

# ===== Netbox Config =====
NETBOX_API_URL=https://demo.netbox.dev/api
NETBOX_API_TOKEN=your_netbox_token_here
